# Distributed revision control system
brew "git"
# Simple terminal UI for git commands
brew "lazygit"
# Organize software neatly under a single directory tree (e.g. /usr/local)
brew "stow"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# UNIX shell (command interpreter)
brew "zsh"
# Fuzzy finder (used by the fzf oh-my-zsh plugin in .zshrc)
brew "fzf"
# Cross-shell prompt (used by .zshrc)
brew "starship"
# Scientific and technical publishing system built on Pandoc
cask "quarto"
uv "mistral-vibe"
# Spec-driven development CLI (specify), installed as a uv tool
uv "specify-cli"
